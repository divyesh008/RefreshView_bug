<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TabletView.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:TabletView"
    Shell.FlyoutBehavior="{OnIdiom Phone=Disabled,Tablet=Locked}"
    Title="TabletView">
   
    <Shell.Resources>
        
    </Shell.Resources>

    <!-- Tab Bar with Text Titles -->
    <TabBar x:Name="Tabs" IsVisible="True">
        <Tab Title="Home" Icon="dotnet_bot">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}"/>
        </Tab>
        <Tab Title="Menu" Icon="dotnet_bot">
            <ShellContent ContentTemplate="{DataTemplate local:MenuPage}" />
        </Tab>
    </TabBar>
    <!--<TabBar Route="home">

         First Tab 
        <Tab Title="Home" Icon="dotnet_bot">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>

         Second Tab 
        <Tab Title="Menu" Icon="dotnet_bot">
            <ShellContent ContentTemplate="{DataTemplate local:MenuPage}" />
        </Tab>

    </TabBar>-->

    <ShellContent
        Title="Home"
        Icon="dotnet_bot"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Menu"
        Icon="dotnet_bot"
        ContentTemplate="{DataTemplate local:MenuPage}"
        Route="MenuPage" />

</Shell>

